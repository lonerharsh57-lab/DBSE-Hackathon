    {
      "name": "Reviews",
      "item": [
        {
          "name": "Create review",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reviews"
              ]
            },
            "description": "Only for your OWN COMPLETED reservation (run after Exit). One review per reservation \u2014 a second one \u2192 409; non-completed \u2192 400. Replace the {{reservationId}} variable value with a completed reservation's id if needed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservationId\": {{reservationId}},\n  \"rating\": 5,\n  \"comment\": \"Smooth entry and exit, slot was easy to find.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Reviews of a location",
          "request": {
            "method": "GET",
