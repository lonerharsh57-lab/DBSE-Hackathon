        {
          "name": "List promo codes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/promos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "promos"
              ]
            },
            "description": "Seeded: WELCOME10 (10% PERCENT) and FLAT50 (\u20b950 FLAT).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Create promo code",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/promos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "promos"
              ]
            },
            "description": "type is PERCENT (% off the surged amount) or FLAT (\u20b9 off).",
